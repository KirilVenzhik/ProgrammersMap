@page "/account/login"
@model LoginModel
@{
    ViewData["NoIndex"] = true;
    ViewData["Title"] = "Вход — Карта программиста";
    var registerHref = string.IsNullOrEmpty(Model.ReturnUrl)
        ? "/account/register"
        : "/account/register?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl);
}

<main class="wrap" id="main" tabindex="-1">
    <div class="auth">
        <h1>Вход</h1>
        <form method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="auth-errors" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Input.Email">Электронная почта</label>
                <input asp-for="Input.Email" type="email" autocomplete="email" required
                       aria-invalid="@AuthFormHelpers.Invalid(ModelState, "Input.Email")"
                       aria-describedby="@AuthFormHelpers.DescribedBy(ModelState, "Input.Email", "login-email-error")" />
                <span asp-validation-for="Input.Email" id="login-email-error" class="auth-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.Password">Пароль</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" required
                       aria-invalid="@AuthFormHelpers.Invalid(ModelState, "Input.Password")"
                       aria-describedby="@AuthFormHelpers.DescribedBy(ModelState, "Input.Password", "login-password-error")" />
                <span asp-validation-for="Input.Password" id="login-password-error" class="auth-error"></span>
            </div>
            <div class="auth-check">
                <input asp-for="Input.RememberMe" type="checkbox" />
                <label asp-for="Input.RememberMe">Запомнить меня</label>
            </div>
            <button type="submit" class="auth-submit">Войти</button>
        </form>
        <p class="auth-note">Нет аккаунта? <a href="@registerHref">Зарегистрироваться</a></p>
    </div>
</main>
