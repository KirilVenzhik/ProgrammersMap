@page "/Error/{code:int}"
@model ErrorModel
@{
    ViewData["NoIndex"] = true;
    ViewData["Title"] = Model.IsNotFound ? "Страница не найдена — Карта программиста" : "Ошибка — Карта программиста";
}

<main class="wrap" id="main" tabindex="-1">
    @if (Model.IsNotFound)
    {
        <h1>Страница не найдена</h1>
        <p>Такой страницы нет. Возможно, ссылка устарела.</p>
    }
    else
    {
        <h1>Что-то пошло не так</h1>
        <p>Не удалось открыть страницу (код @Model.Code).</p>
    }
    <p><a href="/">Вернуться на главную</a></p>
</main>
