@using ProgChecklist.Core
@model Section
@{
    var hideHeading = ViewData["HideSectionHeading"] is true;
}

<section class="sec" id="@Model.Slug" data-section="@Model.Slug">
    @if (!hideHeading)
    {
        <h2><a href="/@Model.Slug">@Model.Title</a> <span data-sc="@Model.Slug">0 / @Model.TopicCount</span></h2>
    }
    @foreach (var group in Model.Groups)
    {
        <div class="group" data-group="@group.Slug">
            @if (hideHeading)
            {
                <h2>@group.Title</h2>
            }
            else
            {
                <h3>@group.Title</h3>
            }
            <ul class="items">
                @foreach (var topic in group.Topics)
                {
                    var key = TopicKey.Create(Model.Slug, topic.Slug);
                    <li data-key="@key" data-level="@topic.Level.ToCode()">
                        <label class="chk" for="cb-@Model.Slug-@topic.Slug"><input type="checkbox" id="cb-@Model.Slug-@topic.Slug" data-key="@key"><span class="visually-hidden">Изучено: @topic.Title</span></label>
                        <a class="txt" href="/@Model.Slug/@topic.Slug">@topic.Title</a>
                        <span class="lvl">@topic.Level.ToDisplayName()</span>
                    </li>
                }
            </ul>
        </div>
    }
</section>
