@using Microsoft.AspNetCore.Identity
@inject ProgChecklist.Web.ISiteUrls SiteUrls
@inject SignInManager<ProgChecklist.Data.AppUser> SignInManager
@{
    var description = ViewData["Description"] as string;
    var canonicalPath = ViewData["CanonicalPath"] as string;
    var pageTitle = ViewData["Title"] as string;
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = "Карта программиста";
    }

    var ogType = ViewData["OgType"] as string ?? "website";
    var noIndex = ViewData["NoIndex"] is true;
    var canonicalUrl = !noIndex && !string.IsNullOrEmpty(canonicalPath) ? SiteUrls.Absolute(canonicalPath) : null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description">
    }
    @if (canonicalUrl is not null)
    {
        <link rel="canonical" href="@canonicalUrl">
    }
    @if (noIndex)
    {
        <meta name="robots" content="noindex">
    }
    <meta property="og:type" content="@ogType">
    <meta property="og:site_name" content="Карта программиста">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:title" content="@pageTitle">
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta property="og:description" content="@description">
    }
    @if (canonicalUrl is not null)
    {
        <meta property="og:url" content="@canonicalUrl">
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600&family=Unbounded:wght@500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <nav class="account-nav" aria-label="Аккаунт">
        @if (SignInManager.IsSignedIn(User))
        {
            var userName = User.Identity?.Name;
            <span class="account-email" title="@userName">@userName</span>
            <form method="post" asp-page="/Account/Logout" class="account-logout">
                <button type="submit" class="account-link">Выйти</button>
            </form>
        }
        else
        {
            // No returnUrl from account pages or re-executed error pages (/Error/404 is not worth returning to).
            var skipReturnUrl = Context.Request.Path.StartsWithSegments("/account") || Context.Request.Path.StartsWithSegments("/Error");
            var query = skipReturnUrl
                ? string.Empty
                : "?returnUrl=" + Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString.Value);
            <a class="account-link" href="/account/login@(query)">Войти</a>
            <a class="account-link" href="/account/register@(query)">Регистрация</a>
        }
    </nav>
    @RenderBody()
    <footer class="wrap">Прогресс сохраняется в этом браузере.</footer>
    <script type="module" src="~/js/progress.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
